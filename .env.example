# EmailJS configuration for the Contact form.
# Create an account at https://www.emailjs.com/ and fill these in.
# Copy this file to ".env" and replace the placeholder values.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Owner sign-in: private GitHub App, installed ONLY on simplyAashir/maashirsheraz.
# Register /api/auth/callback as the callback URL for each allowed site origin.
# These are SERVER variables. Never prefix them with VITE_.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SESSION_SECRET=
# Generate at least 40 random characters for SESSION_SECRET.
# Production: https://maashirsheraz.vercel.app
SITE_URL=http://127.0.0.1:5173
