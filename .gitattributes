# Normalize line endings: Git stores LF, checks out native on each platform.
* text=auto

# Force LF for these text types regardless of platform.
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.svg  text eol=lf

# Treat these as binary (never normalize / diff).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
